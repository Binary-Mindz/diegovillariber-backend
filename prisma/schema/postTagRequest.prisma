model PostTagRequest {
  id           String               @id @default(uuid()) @db.Uuid
  postId       String               @db.Uuid
  taggedUserId String               @db.Uuid
  status       PostTagRequestStatus @default(PENDING)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  post       Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  taggedUser User @relation("PostTagRequests", fields: [taggedUserId], references: [id], onDelete: Cascade)

  @@unique([postId, taggedUserId])
  @@index([taggedUserId, status])
  @@index([postId])
}

enum PostTagRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}
